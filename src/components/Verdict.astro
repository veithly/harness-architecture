---
/**
 * <Verdict tldr="一段话结论" />
 * 用于章节开头。一段密集的结论摘要，覆盖四家的核心取舍。
 *
 * 长内容自适应：当 tldr 超过 ~120 字符（约 1-2 句），
 * 自动切换为「dense」模式，正文切回正文字体（更适合密集阅读），
 * 避免大段 Playfair 形成视觉墙。
 */
interface Props {
  tldr: string;
  tone?: 'default' | 'warn' | 'insight';
}
const { tldr, tone = 'default' } = Astro.props;
const DENSE_THRESHOLD = 120;
const isDense = tldr.length > DENSE_THRESHOLD;
const isEnglish = Astro.url.pathname.startsWith('/en/');

function makePreview(text: string, max = 190) {
  if (text.length <= max) return text;
  const candidate = text.slice(0, max);
  if (isEnglish) {
    const wordBreak = candidate.lastIndexOf(' ');
    return `${candidate.slice(0, wordBreak > 130 ? wordBreak : max).trim()}…`;
  }
  const breaks = ['。', '；', '，', '、'];
  const boundary = Math.max(...breaks.map((mark) => candidate.lastIndexOf(mark)));
  return `${candidate.slice(0, boundary > 110 ? boundary + 1 : max).trim()}…`;
}

const preview = makePreview(tldr);
const expandLabel = isEnglish ? 'Read the complete verdict' : '展开完整结论';
const tagLabel = isEnglish ? 'Verdict' : '结论';
---

<aside class:list={['aap-verdict', `aap-verdict--${tone}`, { 'aap-verdict--dense': isDense }]} role="note" aria-label={isEnglish ? 'Chapter verdict' : '本章结论'}>
  <span class="aap-verdict__tag">{tagLabel}</span>
  <p class="aap-verdict__body">{isDense ? preview : tldr}</p>
  {isDense && (
    <details class="aap-verdict__details">
      <summary>{expandLabel}</summary>
      <p>{tldr}</p>
    </details>
  )}
</aside>

<style>
  .aap-verdict {
    --bar: var(--aap-color-tradeoff);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--aap-sp-4);
    align-items: start;
    border: 1px solid var(--aap-paper-line);
    border-left: 3px solid var(--bar);
    border-radius: var(--aap-radius-md);
    padding: var(--aap-sp-4) var(--aap-sp-6);
    margin: var(--aap-sp-4) 0 var(--aap-sp-6);
    background: var(--aap-paper-soft);
    box-shadow: none;
    position: relative;
  }
  .aap-verdict--warn { --bar: var(--aap-color-risk); }
  .aap-verdict--insight { --bar: var(--aap-color-judgment); }
  .aap-verdict__tag {
    font-family: var(--aap-font-mono);
    font-weight: 700;
    background: var(--bar);
    color: var(--aap-paper);
    padding: 0.2rem 0.55rem;
    border-radius: var(--aap-radius-sm);
    font-size: var(--aap-fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    align-self: flex-start;
  }
  .aap-verdict__body {
    margin: 0;
    line-height: 1.65;
    font-size: var(--aap-fs-md);
    font-family: var(--aap-font-display);
    font-weight: 500;
    color: var(--aap-ink);
    letter-spacing: -0.005em;
  }
  /* 长内容自适应：切回正文字体，降低字号，回到正文级行距 */
  .aap-verdict--dense .aap-verdict__body {
    font-family: var(--aap-font-body);
    font-weight: 400;
    font-size: var(--aap-fs-base);
    line-height: 1.7;
    letter-spacing: 0;
  }
  .aap-verdict__details {
    grid-column: 2;
    margin-top: calc(var(--aap-sp-2) * -1);
    color: var(--aap-ink-soft);
  }
  .aap-verdict__details summary {
    width: fit-content;
    cursor: pointer;
    color: var(--aap-color-tradeoff);
    font-family: var(--aap-font-mono);
    font-size: var(--aap-fs-xs);
    font-weight: 600;
  }
  .aap-verdict__details p {
    margin: var(--aap-sp-3) 0 0;
    font-family: var(--aap-font-body);
    font-size: var(--aap-fs-sm);
    line-height: 1.75;
  }
  @media (max-width: 520px) {
    .aap-verdict { grid-template-columns: 1fr; }
    .aap-verdict__details { grid-column: 1; }
  }
</style>
